# HTTP port the relay listens on
PORT=3000

# GHL webhook trigger to forward received payloads to
WEBHOOK_TARGET_URL=https://services.leadconnectorhq.com/hooks/Sj3yZmY9B84zG9DkUq06/webhook-trigger/6759b0e7-5e00-4e25-b3f7-161655b47338

# Rotate the active log once it reaches this many bytes (default 500MB)
ROTATE_SIZE_BYTES=524288000

# Stop accepting writes when free disk space drops below this (default 2GB)
DISK_FREE_FLOOR_BYTES=2147483648

# Forward retry/backoff settings
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
FORWARD_TIMEOUT_MS=10000

# SMTP settings used to email an alert when a forward permanently fails
# or disk space runs low
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
